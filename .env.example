# PostgreSQL credentials used by Docker Compose.
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=smartcampus
POSTGRES_PORT=5432

# Host port for the FastAPI service.
API_PORT=8000

# MQTT credentials used by the local Mosquitto broker.
MQTT_USERNAME=smartcampus
MQTT_PASSWORD=change-this-mqtt-password

# Used when running the API directly on the host, not through Docker Compose.
DATABASE_URL=postgresql+asyncpg://smartcampus:change-this-local-password@localhost:5432/smartcampus
